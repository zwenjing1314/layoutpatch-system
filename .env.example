# R10：这是变量说明模板，不会被后端整体自动加载。
# auth仅读取进程环境LAYOUTPATCH_DATABASE_PATH、APP_ORIGIN、SESSION_COOKIE_SECURE。
# 数据库CLI用--database，不读取DATABASE_URL；QDRANT_API_KEY由compose消费。
# search读进程QDRANT_URL/API_KEY；API_KEY缺省时只读项目.env同名单项。
# 其余条目为后续设计；前后端启动端口通过命令参数指定。
# 路径由独立项目根目录解析；不要把旧仓库作为输出目录。
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
NEXT_PUBLIC_API_BASE_URL=/api
API_BASE_URL_INTERNAL=http://127.0.0.1:8000

SYSTEM_DATA_ROOT=./runtime
# auth后端可读取此进程变量；路径必须位于本项目runtime内。
LAYOUTPATCH_DATABASE_PATH=./runtime/metadata.sqlite3
# 以下DATABASE_URL仍是设计，不被当前CLI或auth读取。
DATABASE_URL=sqlite:///./runtime/metadata.sqlite3
QDRANT_URL=http://127.0.0.1:6333
# 安装阶段生成；只传给后端与向量库，不能使用 NEXT_PUBLIC_ 前缀。
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=layoutpatch_system
MODEL_WORKER_CONCURRENCY=1
# 上项为已实现固定单worker设计，不解析同名环境变量；用uvicorn --workers 1。
# 本机测试可显式设置LAYOUTPATCH_QUERY_AUDIT_DIR到runtime子目录，保存核验向量；正式默认不设置。

# 本机HTTP开发为false；HTTPS部署必须true。
SESSION_COOKIE_SECURE=false
# 以下三项是已实现的固定默认值，尚不读取同名环境变量。
SESSION_COOKIE_SAMESITE=lax
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800

# 只读指向已有文件。不能只写远程模型名并允许自动下载。
COLPALI_ADAPTER_PATH=
COLPALI_BASE_PATH=
COLPALI_ADAPTER_REVISION=7754422bfa37f8e3cd771e13d4d7f07de3103c95
COLPALI_BASE_REVISION=6ff0d944ea09c3ead97d2bc57427e3d4f01d192f
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
REGION_CHECKPOINT_PATH=
# 设计默认：固定seed0/source_val选择的epoch1；不是三seed论文均值。
REGION_CHECKPOINT_SHA256=18b7ce737b781734560439632137b86cb3ecca017e104cbe587b79a446e47f7b
PARSER_PYTHON_PATH=
PARSER_MODEL_ROOT=
RETRIEVAL_PROFILE=colpali_full_v1
REGION_PROFILE=d_no_text_seed0_v1
# 变量将由新系统实现；关闭Snappy默认OCR、聊天和第二底座。
DEEPSEEK_OCR_ENABLED=false
